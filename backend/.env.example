# =================================================================
# ArthaFlow AI — Backend Environment Configuration
# =================================================================

# Environment Mode: 'development' | 'production' | 'test'
ENVIRONMENT=production

# JWT / Security Secret
SECRET_KEY=generate-secure-32-byte-hex-string-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection String
# PostgreSQL for production:
DATABASE_URL=postgresql://arthaflow_user:password123@dpg-xxxxxx.oregon-postgres.render.com/arthaflow
# Local fallback (SQLite):
# DATABASE_URL=sqlite:///./arthaflow.db

# Gemini AI API Key (Server-side ONLY — Never expose to frontend)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=https://arthaflow.vercel.app,https://arthaflow-ai.vercel.app,http://localhost:3000
