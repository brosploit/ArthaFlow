# =================================================================
# ArthaFlow AI — Environment Configuration Template
# =================================================================
# Copy this file to .env and customize values for your deployment environment.
# NEVER commit your actual .env file or sensitive production keys to git!

# -----------------------------------------------------------------
# Backend Environment
# -----------------------------------------------------------------
ENVIRONMENT=production
PROJECT_NAME="ArthaFlow AI"
VERSION="1.0.0"

# Application Security
# Generate a secure 32+ character key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-super-secret-random-hex-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Note: Render provides DATABASE_URL with postgres:// prefix which ArthaFlow automatically handles.
DATABASE_URL=postgresql://arthaflow_user:password123@dpg-xxxxxx.oregon-postgres.render.com/arthaflow

# AI / Google Gemini
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# CORS Allowed Origins
# Comma-separated list of allowed frontend domains. Do NOT use wildcard '*' in production.
CORS_ORIGINS=https://arthaflow.vercel.app,https://arthaflow-ai.vercel.app,http://localhost:3000

# -----------------------------------------------------------------
# Frontend Environment (Vercel)
# -----------------------------------------------------------------
# URL pointing to the deployed Render backend API endpoint
VITE_API_URL=https://arthaflow-backend.onrender.com/api/v1
